    "memory": {
        "states": {
            "c": 90,
            "h": 60,
            "m": 20
        },
        "interval": 30,
        "format": "󰾆 {used}GB",
        "rotate": "${r_deg}",
        "format-m": "󰾅 {used}GB",
        "format-h": "󰓅 {used}GB",
        "format-c": " {used}GB",
        "format-alt": "󰾆 {percentage}%",
        "max-length": 10,
        "tooltip": true,
        "tooltip-format": "󰾆 {percentage}%\n {used:0.1f}GB/{total:0.1f}GB"
    },    
    "mpris": {
        "format": "{player_icon} {dynamic}",
        "rotate": "${r_deg}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
